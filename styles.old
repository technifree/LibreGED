def get_tag_input_style(theme="light"):
    if theme == "dark":
        return """
        QComboBox {
            background-color: #ffffff;
            color: white;
            border: none;
            border-radius: 14px;
            padding: 6px 8px;
            font-size: 12px;
        }

        QComboBox::drop-down {
            subcontrol-origin: padding;
            subcontrol-position: top right;
            width: 20px;
            border-left: 1px solid #666;
            background-color: transparent;
        }

        QComboBox QAbstractItemView {
            background-color: #2e2e2e;
            color: white;
        }
        """
    else:
        return """
        QComboBox {
            background-color: #ffffff;
            color: black;
            border: 1px solid #b0b0b0;
            border-radius: 14px;
            padding: 6px 8px;
            font-size: 12px;
        }

        QComboBox::drop-down {
            subcontrol-origin: padding;
            subcontrol-position: top right;
            width: 20px;
            border-left: 1px solid #ccc;
            background-color: transparent;
        }

        QComboBox QAbstractItemView {
            background-color: white;
            color: black;
        }
        """

