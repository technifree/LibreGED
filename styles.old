from PySide6.QtWidgets import QApplication


LIGHT_THEME_STYLESHEET = """
QMainWindow {
    background-color: #fdfdfd;
    color: #202020;
}
QLabel, QLineEdit, QTextEdit {
    color: #202020;
    background-color: #ffffff;
}
QLineEdit#SearchBar {
    background-color: #f0f0f0;
    border: 1px solid #ccc;
    border-radius: 6px;
    padding: 6px 8px;
}
QTreeWidget::item {
    color: #000000;
    padding: 4px;
    height: 22px;
}
QTreeWidget::item:hover {
    background-color: #e6f0ff;
}
QTreeWidget::item:selected {
    background-color: #d0e7ff;
    color: #000000;
}
QScrollArea {
    background-color: #ffffff;
}
QToolTip {
    background-color: #83a9e5;
    color: white;
    border: transparent;
    padding: 4px;
    font-size: 11px;
    border-radius: 20px;
}
#PreviewContent {
    background-color: transparent;
    border: 2px solid #007BFF;
    border-radius: 15px;
    padding: 10px;
}
"""

DARK_THEME_STYLESHEET = """
QMainWindow {
    background-color: #2e2e2e;
    color: white;
}
QLabel, QLineEdit, QTextEdit {
    color: white;
    background-color: transparent;
}
QLineEdit#SearchBar {
    background-color: #333333;
    border: 1px solid #666;
    border-radius: 6px;
    padding: 6px 8px;
}
QTreeWidget {
    background-color: #1f1f1f;
    color: white;
    border: none;
    border-radius: 12px;
    padding: 4px;
}
QTreeWidget::item {
    padding: 4px;
    height: 22px;
}
QTreeWidget::item:hover {
    background-color: #2c2c2c;
}
QTreeWidget::item:selected {
    background-color: #333333;
    color: white;
}
QScrollArea {
    background-color: transparent;
}
QToolTip {
    background-color: #83a9e5;
    color: white;
    border: transparent;
    padding: 4px;
    font-size: 11px;
    border-radius: 20px;
}
#PreviewContainer {
    border: 2px solid #007BFF;
    border-radius: 15px;
    background-color: #ffffff;
    padding: 10px;
}
"""

def apply_common_styles(window):
    for btn in [
        window.reindex_button,
        window.import_button,
        window.reset_button,
        window.info_button,
        window.theme_button,
        window.search_button,
        window.zoom_in_button,
        window.zoom_out_button,
        window.prev_page_button,
        window.next_page_button,
        window.meta_tag_add_button,
    ]:
        btn.setStyleSheet(get_uniform_button_style())
        btn.setFixedSize(40, 40)

    window.tree.setStyleSheet(
        DARK_THEME_STYLESHEET if window.current_theme == "dark" else LIGHT_THEME_STYLESHEET
    )
    window.metadata_form.setStyleSheet(
        get_metadata_form_style(window.current_theme)
    )
    scrollbar_style = get_scrollbar_style(window.current_theme)
    app_style = QApplication.instance().styleSheet()
    QApplication.instance().setStyleSheet(app_style + scrollbar_style)

def get_uniform_button_style():
    return """
    QPushButton {
        background-color: transparent;
        border: none;
        border-radius: 20px;
        padding: 6px;
    }
    QPushButton:hover {
        background-color: #e0e0e0;
    }
    QToolTip {
        background-color: #83a9e5;
        color: white;
        border: transparent;
        padding: 4px;
        font-size: 11px;
        border-radius: 20px;
    }
    """

def get_save_button_style():
    return """
    QPushButton {
        font-size: 13px;
        padding: 8px 16px;
        background-color: #007BFF;
        color: white;
        border: none;
        border-radius: 20px;
        font-weight: bold;
    }
    QPushButton:hover {
        background-color: #0056b3;
    }
    """

def get_tag_add_button_style():
    return """
    QPushButton#tagAddButton {
        background-color: #444;
        color: white;
        border: none;
        font-size: 12px;
        border-radius: 12px;
        padding: 4px;
    }
    QPushButton#tagAddButton:hover {
        background-color: white;
        color: black;
    }
    """

def get_save_confirmation_label_style():
    return """
    QLabel {
        color: green;
        font-size: 11px;
        padding: 4px;
    }
    """

def get_light_button_style():
    return """
    QPushButton {
        border: 1px solid #bbb;
        border-radius: 12px;
        background-color: #f4f4f4;
        color: #202020;
        padding: 6px;
    }
    QPushButton:hover {
        background-color: #dddddd;
    }
    """

def get_dark_button_style():
    return """
    QPushButton {
        border: 1px solid #555;
        border-radius: 12px;
        background-color: #444;
        color: white;
        padding: 6px;
    }
    QPushButton:hover {
        background-color: #666;
    }
    """

def get_theme_button_style(theme="light"):
    return get_dark_button_style() if theme == "dark" else get_light_button_style()


